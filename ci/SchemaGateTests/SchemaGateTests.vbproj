<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GamaPrintAgent.SchemaGateTests</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Compile Include="../../src/SpikeTransport/SchemaGate.vb" Link="SchemaGate.vb" />
    <Compile Include="../../src/SpikeTransport/SaleV2Parser.vb" Link="SaleV2Parser.vb" />
    <Compile Include="../../src/SpikeTransport/ReceiptNameLayout.vb" Link="ReceiptNameLayout.vb" />
    <Compile Include="../../src/SpikeTransport/SaleV2Format.vb" Link="SaleV2Format.vb" />
  </ItemGroup>
</Project>
